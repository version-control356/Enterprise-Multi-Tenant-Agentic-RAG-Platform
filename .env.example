# App Configuration
PROJECT_NAME="Multi-Tenant Agentic RAG Platform"
ENVIRONMENT="development"
SECRET_KEY="replace-with-a-unique-32-character-minimum-secret"
ALGORITHM="HS256"

# Groq Cloud Configuration
GROQ_API_KEY="replace-with-your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-20b"
USE_LLM_GRADER=true

# Cohere Cross-Encoder Reranker (Optional)
COHERE_API_KEY=""
COHERE_RERANK_MODEL="rerank-v3.5"
USE_COHERE_RERANK=false
COHERE_TOP_N=5

# Langfuse Observability & Tracing
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# Database Connections
POSTGRES_USER="rag_user"
POSTGRES_PASSWORD="rag_password"
POSTGRES_DB="rag_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="rediss://default:replace-with-redis-password@your-redis-host:6379"

QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_URL="https://your-qdrant-cluster-url"
QDRANT_API_KEY="replace-with-your-qdrant-api-key"

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS="http://localhost:8501"
AUTH_MODE="local"
OIDC_JWKS_URL=""
OIDC_ISSUER=""
OIDC_AUDIENCE=""
OIDC_TENANT_CLAIM="tenant_id"
OIDC_ROLE_CLAIM="role"
OIDC_ALGORITHMS="RS256"
PII_PROVIDER="presidio"
REDACT_DOCUMENT_PII=false
PROMPT_GUARDRAILS_PROVIDER="nemo"
NEMO_CHECK_MODE="suspicious"
NEMO_GUARDRAILS_CONFIG_PATH="guardrails"
REQUIRE_REDIS=false

# Initial tenant administrator. This user is created only if it does not exist.
BOOTSTRAP_ADMIN_USERNAME="admin_user"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-bootstrap-password-under-72-bytes"
BOOTSTRAP_ADMIN_TENANT_ID="tenant_alpha"

# Enable only for a local demo; production tenants should be provisioned by an administrator.
ALLOW_SELF_REGISTRATION=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_BYTES=10485760
AUTH_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=30
