#App Configuration
PROJECT_NAME="Multi-Tenant Agentic RAG Platform"
ENVIRONMENT="production"
SECRET_KEY="replace-with-a-unique-32-character-minimum-secret"
ALGORITHM="HS256"

#Groq Cloud Configuration
GROQ_API_KEY="replace-with-your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-20b"
USE_LLM_GRADER=true

#Cohere Cross-Encoder Reranker (Optional)
COHERE_API_KEY=""
COHERE_RERANK_MODEL="rerank-v3.5"
USE_COHERE_RERANK=false
COHERE_TOP_N=5

#Langfuse Observability & Tracing
LANGFUSE_PUBLIC_KEY="replace-with-your-langfuse-public-key"
LANGFUSE_SECRET_KEY="replace-with-your-langfuse-secret-key"
LANGFUSE_HOST="https://cloud.langfuse.com"

#Database Connections (Supabase PostgreSQL)
POSTGRES_USER="replace-with-your-supabase-user"
POSTGRES_PASSWORD="replace-with-your-supabase-password"
POSTGRES_DB="postgres"
POSTGRES_HOST="replace-with-your-supabase-pooler-host"
POSTGRES_PORT=6543

#Serverless Caching (Upstash Redis)
REDIS_HOST="replace-with-your-upstash-host-domain"
REDIS_PORT=6379
REDIS_URL="replace-with-your-upstash-rediss-connection-url"

#Hosted Vector Engine (Qdrant Cloud)
QDRANT_HOST="replace-with-your-qdrant-cluster-host-domain"
QDRANT_PORT=6333
QDRANT_URL="replace-with-your-qdrant-cluster-https-url"
QDRANT_API_KEY="replace-with-your-qdrant-api-key"

#Live Cloud Routing
AUTH_MODE="local"
CORS_ORIGINS="https://tenantrag.streamlit.app"
API_BASE_URL="https://enterprise-multi-tenant-agentic-rag.onrender.com"

#Security & Guardrails Engines
PII_PROVIDER="presidio"
REDACT_DOCUMENT_PII=false
PROMPT_GUARDRAILS_PROVIDER="nemo"
NEMO_CHECK_MODE="suspicious"
NEMO_GUARDRAILS_CONFIG_PATH="guardrails"
REQUIRE_REDIS=false

#Initial System Administration
BOOTSTRAP_ADMIN_USERNAME="admin_user"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-bootstrap-password-under-72-bytes"
BOOTSTRAP_ADMIN_TENANT_ID="tenant_alpha"

#Advanced Scale Metrics
ALLOW_SELF_REGISTRATION=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_BYTES=10485760
AUTH_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=30
